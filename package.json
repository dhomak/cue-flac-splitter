{
  "name": "music-tools",
  "version": "1.0.0",
  "description": "Web GUI for music processing scripts",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "setup": "node setup.js",
    "build": "electron-builder --mac",
    "test": "jest --testPathPatterns=server.test.js --forceExit"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "com.musictools.app",
    "productName": "Music Tools",
    "asar": true,
    "afterPack": "./after-pack.js",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "**/*",
      "!.git/**",
      "!*.sh",
      "!*.pl",
      "!*.py",
      "!venv/**",
      "!vendor/**",
      "!setup.js",
      "!after-pack.js",
      "!rutracker_magnets.txt",
      "!python_venv_manual.txt"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "scripts",
        "filter": [
          "*.sh",
          "*.pl",
          "*.py",
          "!server.js"
        ]
      },
      {
        "from": "pylibs",
        "to": "pylibs"
      },
      {
        "from": "vendor",
        "to": "vendor"
      }
    ]
  }
}
